{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequirementAnalysisInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "analysis_scope",
    "client_profile",
    "conflicts",
    "constraints",
    "metadata",
    "question_context"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "adapter_version",
        "profile_path",
        "pending_path",
        "conversation_log_path",
        "intake_complete"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "const": "client_intake"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "profile_path": {
          "type": "string",
          "minLength": 1
        },
        "pending_path": {
          "type": "string",
          "minLength": 1
        },
        "conversation_log_path": {
          "type": "string",
          "minLength": 1
        },
        "intake_complete": {
          "type": "boolean"
        }
      }
    },
    "analysis_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "medical",
          "critical_illness",
          "accident",
          "life",
          "savings"
        ]
      }
    },
    "client_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "inferred_notes",
        "follow_up_items",
        "handoff_notes"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fact"
          }
        },
        "inferred_notes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/inferredNote"
          }
        },
        "follow_up_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoff_notes": {
          "type": "string"
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/conflict"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/constraint"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "client_alias"
      ],
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "client_alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asked_questions",
        "answered_fields"
      ],
      "properties": {
        "asked_questions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/askedQuestion"
          }
        },
        "answered_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "valueStatus": {
      "type": "string",
      "enum": [
        "KNOWN",
        "UNKNOWN",
        "ESTIMATED",
        "ASSUMED"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value",
        "value_status",
        "source_round",
        "source_text",
        "source_section"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "value_status": {
          "$ref": "#/definitions/valueStatus"
        },
        "source_round": {
          "type": "string",
          "minLength": 1
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "source_section": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inferredNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "basis",
        "source_round"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "source_round": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "values",
        "reason",
        "resolution_status"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "resolution_status": {
          "type": "string",
          "enum": [
            "UNRESOLVED",
            "RESOLVED_USE_NEW",
            "RESOLVED_USE_OLD",
            "NEEDS_CONFIRMATION"
          ]
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "source"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "customer_preference",
            "budget_signal",
            "follow_up_item",
            "data_quality_note"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "askedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "status",
        "ask_count"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "asked",
            "answered",
            "ignored",
            "pending",
            "conflict_confirmation_needed"
          ]
        },
        "ask_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_question": {
          "type": "string"
        }
      }
    }
  }
}
