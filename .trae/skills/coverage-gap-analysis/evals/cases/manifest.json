{
  "skill": "coverage-gap-analysis",
  "schema_version": "1.0",
  "description": "CoverageGap 判定数据集（单一真源）。每个 case 的 fixture 为三 Artifact 复合输入，checks 为可机检断言。",
  "cases": [
    {
      "case_id": "case-01-basic",
      "fixture": "fixtures/unit/coverage_gap/case-01-basic.json",
      "intent": "混合覆盖：寿险已充分（跳过），其余部分/无覆盖",
      "checks": {
        "expected_status": "COMPLETE",
        "min_gaps": 4,
        "expect_gap_levels": ["CRITICAL", "HIGH", "MEDIUM"],
        "deny_gap_levels": ["UNKNOWN"],
        "must_skip_domain": "life"
      }
    },
    {
      "case_id": "case-02-partial",
      "fixture": "fixtures/unit/coverage_gap/case-02-partial.json",
      "intent": "全部部分覆盖：应为 HIGH/MEDIUM/LOW，无 CRITICAL/UNKNOWN",
      "checks": {
        "expected_status": "COMPLETE",
        "min_gaps": 5,
        "expect_gap_levels": ["HIGH", "MEDIUM", "LOW"],
        "deny_gap_levels": ["CRITICAL", "UNKNOWN"]
      }
    },
    {
      "case_id": "case-03-no-coverage",
      "fixture": "fixtures/unit/coverage_gap/case-03-no-coverage.json",
      "intent": "全部无覆盖：应为 CRITICAL/HIGH/MEDIUM",
      "checks": {
        "expected_status": "COMPLETE",
        "min_gaps": 5,
        "expect_gap_levels": ["CRITICAL", "HIGH", "MEDIUM"],
        "deny_gap_levels": ["UNKNOWN"]
      }
    },
    {
      "case_id": "case-04-unknown",
      "fixture": "fixtures/unit/coverage_gap/case-04-unknown.json",
      "intent": "身故保障未知：应出现 UNKNOWN 缺口且整体 NEED_MORE_INFORMATION",
      "checks": {
        "expected_status": "NEED_MORE_INFORMATION",
        "min_gaps": 2,
        "expect_gap_levels": ["UNKNOWN", "CRITICAL"],
        "require_information_gaps": true
      }
    },
    {
      "case_id": "case-05-preliminary",
      "fixture": "fixtures/unit/coverage_gap/case-05-preliminary.json",
      "intent": "风险分析为 PRELIMINARY：整体状态应为 PRELIMINARY，寿险已充分跳过",
      "checks": {
        "expected_status": "PRELIMINARY",
        "min_gaps": 1,
        "deny_gap_levels": ["UNKNOWN"],
        "must_skip_domain": "life"
      }
    }
  ]
}
