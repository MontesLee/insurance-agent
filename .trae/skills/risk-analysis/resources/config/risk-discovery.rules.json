{
  "rules_version": "1.0",
  "taxonomy_version": "1.0",
  "method": "risk_dependency_graph_v1",
  "description": "risk-analysis 风险发现规则（R1–R5）。gate.any_of 逐信号求值 → MATCHED / ABSENT / UNRESOLVED；∃MATCHED=IDENTIFIED，∃UNRESOLVED=UNDETERMINED，∀ABSENT=NOT_IDENTIFIED。规则全部外置，引擎零业务判断、零 LLM。",
  "shared_sources": {
    "groups": "risk-sufficiency.rules.json",
    "question_templates": "risk-sufficiency.rules.json",
    "fallback_question_template": "risk-sufficiency.rules.json",
    "analysis_status_precedence": "risk-sufficiency.rules.json#analysis_status_rules.precedence",
    "note": "groups / question_templates / precedence 以充分性规则文件为单一真源；本文件的 groups 只补充 discovery 专有分组（person_facts），同名以本文件为准。"
  },
  "status_satisfied": [
    "KNOWN",
    "ESTIMATED",
    "ASSUMED",
    "INFERRED"
  ],
  "negative_tokens": [
    "无",
    "没有",
    "无房贷",
    "无负债",
    "无贷款",
    "无子女",
    "无赡养",
    "无其他",
    "不承担",
    "不适用",
    "未参保",
    "否",
    "none",
    "no",
    "n/a",
    "na"
  ],
  "negative_prefixes": [
    "无",
    "没有",
    "none",
    "no"
  ],
  "negative_substrings": [
    "无需",
    "无须",
    "不需要",
    "不用",
    "暂无",
    "尚未",
    "不承担",
    "无赡养",
    "无贷款",
    "无负债",
    "无房贷",
    "无子女"
  ],
  "number_units": {
    "亿": 100000000,
    "千万": 10000000,
    "百万": 1000000,
    "万": 10000,
    "万元": 10000,
    "w": 10000,
    "千": 1000,
    "k": 1000
  },
  "groups": {
    "person_facts": {
      "any_of": [
        "age",
        "gender",
        "marital_status",
        "children_count",
        "city"
      ],
      "description": "家庭成员基本事实。R1 普适暴露仍需要至少一条家庭事实支撑，避免对完全未知的客户直接断言风险成立。"
    }
  },
  "field_labels": {
    "age": "年龄",
    "gender": "性别",
    "city": "常住城市",
    "marital_status": "婚姻状况",
    "spouse_employment": "配偶就业状况",
    "spouse_income": "配偶年收入",
    "children_count": "子女数量",
    "children_info": "子女情况",
    "dependents": "其他被扶养人",
    "household_income": "家庭年收入",
    "annual_income": "本人年收入",
    "household_expense": "家庭年支出",
    "assets": "可动用金融资产",
    "cash_flow": "年度结余",
    "premium_budget": "风险管理预算",
    "mortgage_balance": "房贷余额",
    "liabilities": "其他负债",
    "children_education": "子女教育规划",
    "elderly_support": "赡养责任",
    "family_responsibility": "家庭长期责任",
    "social_insurance_status": "社保/医保参保状态",
    "existing_life_coverage": "已有人身寿险保额",
    "existing_critical_illness_coverage": "已有重疾保障保额",
    "existing_medical_coverage": "已有商业医疗保障",
    "existing_accident_coverage": "已有意外/伤残保障保额",
    "employer_benefits": "单位福利保障",
    "customer_health": "健康状况",
    "health_history": "既往病史",
    "occupation": "职业",
    "employment_type": "用工形态",
    "income_stability": "收入稳定性"
  },
  "requirement_type_to_domain": {
    "medical": "R1",
    "critical_illness": "R2",
    "accident": "R3",
    "life": "R4",
    "savings": "R5"
  },
  "text_templates": {
    "identified": "已确认暴露：{matched}。",
    "identified_amplifiers": "放大因素：{amplifiers}。",
    "not_identified": "未识别到构成该风险的事实：{absent}。按 unknown > fabricated certainty 原则，不推断其成立。",
    "undetermined": "暴露事实不足，无法判定该风险是否成立：{unresolved}。保持 UNKNOWN，不做二值化猜测。",
    "requirement_attention": "需求层已提出 {requirement_type} 相关关注（{requirement_id}），但事实层缺少判定依据，不得据此认定风险成立。",
    "joiner": "；"
  },
  "unknown_reason_templates": {
    "unresolved": "判定 {domain} 是否成立需要该字段，当前状态为 UNKNOWN，不得推断、不得用默认值替代。",
    "conflict": "CONFLICT_UNRESOLVED：该字段存在不一致取值，澄清前不得用于判定风险是否成立。",
    "missing": "上游未提供该字段（status=UNKNOWN），风险暴露无法判定。"
  },
  "assumption_reason_default": "状态为 {status} 但未填写依据（note），unknown_integrity 检查将判定不合规。",
  "questioning": {
    "max_questions": 3,
    "spread_step": 0.5,
    "spread_cap": 2.0,
    "normalizer": 2.0,
    "priority_thresholds": {
      "HIGH": 0.75,
      "MEDIUM": 0.45
    },
    "formula": "resolution_value = min(weight * spread / normalizer, 1.0); spread = min(1 + step*(受影响域数-1), cap)",
    "note": "发现阶段的追问解决『这个风险到底成不成立』，与充分性阶段的『信息够不够量化』不同；已由充分性阶段问过的字段自动去重。"
  },
  "domains": {
    "R1": {
      "name": "Medical Risk",
      "name_zh": "医疗支出风险",
      "universal_exposure": true,
      "trigger_event": "家庭成员发生疾病或意外受伤，产生需要家庭自行承担的医疗支出",
      "gate": {
        "any_of": [
          {
            "id": "R1-G1",
            "group": "person_facts",
            "op": "group_status_satisfied",
            "weight": 1.0,
            "description": "已掌握家庭成员基本事实，医疗支出风险对该家庭成立"
          }
        ]
      },
      "amplifiers": [
        {
          "id": "R1-A1",
          "field": "social_insurance_status",
          "op": "status_absent",
          "weight": 0.8,
          "description": "社保/医保参保状态为无或未参保，医疗支出需更高比例自付"
        },
        {
          "id": "R1-A2",
          "field": "existing_medical_coverage",
          "op": "numeric_eq",
          "value": 0,
          "absent_when_false": false,
          "weight": 0.8,
          "description": "无商业医疗保障，医保之外的支出缺口需家庭自行承担"
        },
        {
          "id": "R1-A3",
          "field": "customer_health",
          "op": "string_contains",
          "value": [
            "异常",
            "脂肪肝",
            "结节",
            "高血压",
            "糖尿病",
            "高血脂",
            "尿酸",
            "慢性",
            "息肉",
            "囊肿",
            "结石",
            "肝炎",
            "增生"
          ],
          "absent_when_false": false,
          "weight": 0.7,
          "description": "已知存在健康异常记录，医疗支出发生概率上升"
        },
        {
          "id": "R1-A4",
          "field": "children_count",
          "op": "numeric_gt",
          "value": 0,
          "absent_when_false": false,
          "weight": 0.4,
          "description": "家庭有未成年子女，医疗事件发生频率通常更高"
        },
        {
          "id": "R1-A5",
          "field": "dependents",
          "op": "status_satisfied",
          "weight": 0.4,
          "description": "存在其他需要照护的家庭成员"
        },
        {
          "id": "R1-A6",
          "field": "employer_benefits",
          "op": "status_absent",
          "weight": 0.3,
          "description": "单位未提供补充医疗福利，缺少第二层支付来源"
        }
      ]
    },
