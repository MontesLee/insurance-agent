{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "risk-analysis-output.schema.json",
  "title": "RiskAnalysisOutput",
  "description": "risk-analysis 引擎输出。机器可读 JSON 是唯一事实源，Markdown 报告只是渲染层。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_version",
    "layer",
    "upstream",
    "analysis_status",
    "overall_confidence",
    "sufficiency",
    "family_risk_overview",
    "risks",
    "risk_matrix",
    "top_priorities",
    "unknowns",
    "assumptions",
    "next_information_needed",
    "missing_from_upstream",
    "guardrails",
    "eval"
  ],
  "properties": {
    "output_version": { "type": "string", "const": "1.0" },
    "layer": { "type": "string", "const": "risk_analysis" },
    "upstream": { "type": "string", "const": "requirement_analysis" },

    "analysis_status": {
      "type": "string",
      "enum": [
        "FORMAL",
        "PRELIMINARY",
        "NEED_MORE_INFORMATION",
        "CONFLICTING_INFORMATION",
        "NEEDS_REVIEW",
        "FAILED"
      ]
    },
    "overall_confidence": { "type": "number", "minimum": 0, "maximum": 1 },

    "sufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sufficiency_status", "method", "domain_results", "blocking_fields", "conflict_fields"],
      "properties": {
        "sufficiency_status": { "type": "string", "enum": ["SUFFICIENT", "PARTIAL", "INSUFFICIENT", "CONFLICTING"] },
        "method": { "type": "string", "const": "risk_dependency_graph_v1" },
        "sufficiency_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "domain_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risk_category", "score", "status", "blocking_fields", "conflict_fields"],
            "properties": {
              "risk_category": { "type": "string", "enum": ["R1", "R2", "R3", "R4", "R5"] },
              "score": { "type": "number", "minimum": 0, "maximum": 1 },
              "status": { "type": "string", "enum": ["SUFFICIENT", "PARTIAL", "INSUFFICIENT", "CONFLICTING"] },
              "blocking_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "conflict_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "blocking_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "conflict_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },

    "family_risk_overview": { "type": "string", "minLength": 1 },

    "risks": {
      "type": "array",
      "items": { "$ref": "risk.schema.json" }
    },

    "risk_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "risk_category", "severity", "likelihood", "residual_risk", "priority"],
        "properties": {
          "risk_id": { "type": "string", "minLength": 1 },
          "risk_category": { "type": "string", "enum": ["R1", "R2", "R3", "R4", "R5"] },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "likelihood": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
          "residual_risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"] },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] }
        }
      }
    },

    "top_priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "priority", "reason"],
        "properties": {
          "risk_id": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },

    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "assumption", "reason"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "assumption": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },

    "next_information_needed": {
      "type": "array",
      "description": "按 Expected Information Value 排序，只问对当前风险结论影响最大的缺失信息，不得机械罗列所有缺失字段。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "question", "why_needed", "affects_risks", "priority", "expected_information_value"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^Q[0-9]{3}$" },
          "question": { "type": "string", "minLength": 1 },
          "why_needed": { "type": "string", "minLength": 1 },
          "affects_risks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["R1", "R2", "R3", "R4", "R5"] }
          },
          "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "expected_information_value": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },

    "missing_from_upstream": {
      "type": "array",
      "description": "上游未提供的输入。只在此登记，绝不反向修改上游 Skill。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "field", "reason"],
        "properties": {
          "source": { "type": "string", "enum": ["client-intake", "requirement-analysis"] },
          "field": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },

    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_recommendation_included", "sales_language_detected", "layer_note"],
      "properties": {
        "product_recommendation_included": { "type": "boolean", "const": false },
        "sales_language_detected": { "type": "boolean", "const": false },
        "layer_note": { "type": "string", "minLength": 1 }
      }
    },

    "eval": { "$ref": "eval-result.schema.json" }
  }
}
