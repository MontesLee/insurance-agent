{
  "version": "1.0",
  "description": "Knowledge Search 排序规则（外置，引擎只读）。权重不必和为1，最终做 min-max 归一。",
  "weights": {
    "semantic": 0.10,
    "keyword": 0.35,
    "domain": 0.20,
    "source": 0.25,
    "specificity": 0.10
  },
  "source_quality": {
    "S": 1.0,
    "A": 0.85,
    "B": 0.65,
    "C": 0.45,
    "D": 0.2
  },
  "domain_match_bonus": 1.0,
  "domain_mismatch_penalty": 0.35,
  "specificity_full": 1.0,
  "specificity_generic": 0.5,
  "partial_threshold": 0.70,
  "conflict_keys": ["等待期", "免赔额", "赔付比例"]
}
