{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 11 benchmark case",
  "type": "object",
  "required": [
    "case_id",
    "name",
    "category",
    "description",
    "input",
    "expected"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^B[0-9]{3}$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "required": [
        "graph"
      ],
      "properties": {
        "graph": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "tasks"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "description": "bare task-list shorthand (wrapped by the runner)"
            }
          ]
        },
        "scripts": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "array"
            ]
          }
        },
        "planner_graphs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "array"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "candidate graphs (dict/list) or raw provider strings for failure injection"
        },
        "seed_client_profile": {
          "type": "boolean"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "max_replans": {
          "type": "integer",
          "minimum": 0
        },
        "approval_policy": {
          "type": "boolean"
        },
        "intervention_policy": {
          "type": "object"
        },
        "human_steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "terminal_status": {
          "type": "string"
        },
        "required_agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_repairs": {
          "type": "integer"
        },
        "max_replans": {
          "type": "integer"
        },
        "exact_failed_evals": {
          "type": "integer"
        },
        "graph_revision": {
          "type": "integer"
        },
        "previous_revision_immutable": {
          "type": "boolean"
        }
      }
    }
  }
}