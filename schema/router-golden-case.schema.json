{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "router-golden-case.schema.json",
  "title": "Router Golden Case contract (Phase 28.B4)",
  "description": "One comparable turn for the B4 equivalence gate. Single source: tests/golden/router_cases.json is validated against this schema by tests/runtime/test_p28b4_gate.py AND loaded by runtime/evaluation/router_equivalence/models.load_cases — the contract test and the runner can never drift. Script items: \"plain text reply\" | {\"tool\",\"args\"} (one tool call) | {\"error\": msg} (provider failure). No insurance facts may be invented: answers must quote the existing fixtures KB / demo catalog, or be refused.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "intent", "message", "equivalence_class", "equivalence_type", "script"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^GC-[A-Z0-9]+-[A-Z0-9]+$"},
          "intent": {"enum": ["insurance_qa", "product_qa", "insurance_plan", "modify_existing_plan", "unknown_insurance_intent"]},
          "message": {"type": "string", "minLength": 1},
          "equivalence_class": {"enum": ["E1", "E2"]},
          "equivalence_type": {"enum": [
            "grounded_answer", "insufficient_evidence", "kb_unavailable",
            "llm_unavailable", "hallucinated_citation",
            "product_existing", "product_missing", "d6_missing_fact",
            "context_reference", "forbidden_recommendation",
            "plan_artifact_equality", "plan_preserve",
            "clarification", "safe_fallback"
          ]},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "grounding_status": {"enum": ["grounded", "partial_grounding", "refused"]},
              "failure_reason": {"enum": ["kb_unavailable", "insufficient_evidence", "llm_unavailable", "citation_gate_rejected", "catalog_missing_fact", "invalid_input", "internal_error"]},
              "intent": {"type": "string"},
              "clarification_required": {"type": "boolean"},
              "product_id": {"type": "string", "pattern": "^P[0-9]+$"}
            }
          },
          "script": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {"type": "object", "additionalProperties": false, "required": ["tool"], "properties": {"tool": {"type": "string", "minLength": 1}, "args": {"type": "object"}}},
                {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "string", "minLength": 1}}}
              ]
            }
          },
          "context": {"type": "array", "items": {"type": "string"}},
          "flags": {"type": "object", "additionalProperties": {"type": "string"}},
          "service": {"enum": ["default", "dead"]},
          "fixture_source": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
