# LLM configuration for Agent Mode (Phase 2.6+)
# Copy this file to `.env` and fill in YOUR values. `.env` is git-ignored.
#
# GLM works through the OpenAI-compatible endpoint — no separate provider code.
# Precedence: process environment variables > this .env file > defaults.

LLM_PROVIDER=glm
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Reasoning budget for ALWAYS-THINKING models (optional; default: low).
# GLM's glm-5.3 refuses to disable thinking (API error 1210) and accepts
# low | high | max. With a provider default that lets thinking run unbounded,
# the agent-loop step-1 call streamed 6000+ reasoning deltas and never reached
# its tool call before the 240s generation watchdog killed it — every attempt
# timed out, so the turn always ended "没能生成有效的分析步骤". A bounded
# budget is therefore mandatory.
#
# NOTE (28.K.28): reasoning IS now rendered — the step-output box shows it in a
# de-emphasized "思考" segment. So this budget is USER-VISIBLE CONTENT, and the
# tier is a product trade-off, not just a safety valve. Measured on this repo's
# real prompt + all 11 tool specs (2026-09-28, glm-5.3 / glm-5.3-flash):
#   low  → fastest (6.1–16.3s); 16–56 deltas, 72–265 chars. A CONTINUATION step
#          (after a tool result) can stream NOTHING AT ALL and still complete in
#          5.7s → the step box stays empty while the step finishes.
#   high → 107–242 deltas, 499–1146 chars (4–8x more), 11.8–30.4s; ~+5s per
#          continuation step. Recommended when the step box is user-visible.
#   max  → measured: 2456 deltas / 10k chars and STILL streaming after 90s,
#          never reaching its tool call → collides with the 240s watchdog.
#          DO NOT USE.
#   low | high | max       → sent as `reasoning_effort`
#   default | none | off   → omit the parameter (provider default behaviour)
# LLM_REASONING_EFFORT=high

# Optional cost tier (Lawgent-style): routine agent steps run on the fast model;
# leave LLM_FAST_MODEL unset (or equal to LLM_MODEL) for single-tier behaviour.
# LLM_FAST_MODEL=glm-5.3-flash

# Other OpenAI-compatible backends work the same way, e.g.:
# LLM_PROVIDER=openai
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
