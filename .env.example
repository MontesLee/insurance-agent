# LLM configuration for Agent Mode (Phase 2.6+)
# Copy this file to `.env` and fill in YOUR values. `.env` is git-ignored.
#
# GLM works through the OpenAI-compatible endpoint — no separate provider code.
# Precedence: process environment variables > this .env file > defaults.

LLM_PROVIDER=glm
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional cost tier (Lawgent-style): routine agent steps run on the fast model;
# leave LLM_FAST_MODEL unset (or equal to LLM_MODEL) for single-tier behaviour.
# LLM_FAST_MODEL=glm-5.3-flash

# Other OpenAI-compatible backends work the same way, e.g.:
# LLM_PROVIDER=openai
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
